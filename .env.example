# NEXUS-DROP — ne jamais committer .env
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus_change_me
POSTGRES_DB=nexus_drop
DATABASE_URL=postgresql+asyncpg://nexus:nexus_change_me@db:5432/nexus_drop
REDIS_URL=redis://redis:6379/0

ADMIN_EMAIL=admin@nexus-drop.local
ADMIN_PASSWORD=NexusAdmin2026!
JWT_SECRET=change-me-to-a-long-random-secret-nexus-drop
JWT_EXPIRE_MINUTES=10080

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_STORE_URL=http://localhost:3001
# 3001 en local car EBX utilise souvent le port 3000
BACKEND_CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:8080

STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3

# Scraper furtif — proxy recommandé en prod (Bright Data, Oxylabs, Smartproxy…)
SCRAPER_PROXY_URL=
# SCRAPER_PROXY_URL=http://user:pass@proxy.residentiel.com:port

# Clé API CJ Dropshipping (optionnel)
# CJ_DROPSHIPPING_API_KEY=

# Ollama — dev local: localhost | Docker VPS: host.docker.internal
OLLAMA_URL=http://host.docker.internal:11434
AUTO_PUBLISH_CRON_SCHEDULE=0 */6 * * *
AUTO_PUBLISH_MAX_PRODUCTS=10
