# NEXUS-DROP — ne jamais committer .env
# Copiez ce fichier : cp .env.example .env

# --- Environnement ---
# development | production (masque /docs en production)
ENVIRONMENT=production

# --- Base de données (Docker interne uniquement) ---
POSTGRES_USER=nexus
POSTGRES_PASSWORD=CHANGE_ME_use_openssl_rand_hex_32
POSTGRES_DB=nexus_drop
DATABASE_URL=postgresql+asyncpg://nexus:CHANGE_ME_use_openssl_rand_hex_32@db:5432/nexus_drop
REDIS_URL=redis://redis:6379/0

# --- Auth admin ---
ADMIN_EMAIL=admin@nexus-drop.local
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password_min_16_chars
JWT_SECRET=CHANGE_ME_use_openssl_rand_hex_32
JWT_EXPIRE_MINUTES=10080

# --- URLs publiques (VPS : remplacez par votre IP ou domaine) ---
# Tout passe par Nginx :8080 — une seule origine pour boutique + API admin
NEXT_PUBLIC_API_URL=http://51.254.135.158:8080
NEXT_PUBLIC_STORE_URL=http://51.254.135.158:8080
BACKEND_CORS_ORIGINS=http://51.254.135.158:8080,https://votre-domaine.com

# --- Stripe (obligatoire pour encaisser de vrais paiements) ---
# Dashboard : https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook : https://dashboard.stripe.com/webhooks → /webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# --- Ollama (IA listing) ---
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3

# --- Scraper (proxy résidentiel recommandé en prod) ---
SCRAPER_PROXY_URL=
# SCRAPER_PROXY_URL=http://user:pass@proxy.residentiel.com:port

# --- Auto-publish Celery Beat ---
AUTO_PUBLISH_CRON_SCHEDULE=0 */6 * * *
AUTO_PUBLISH_MAX_PRODUCTS=10

# --- CJ Dropshipping (optionnel) ---
# CJ_DROPSHIPPING_API_KEY=
